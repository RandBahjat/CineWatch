{
  "name": "cinewatch-app",
  "version": "1.2.6",
  "description": "CineWatch Movies & Series Standalone Mobile and Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node ../serve-app.js",
    "build:win": "node build-installer.js",
    "dev": "electron ."
  },
  "keywords": [
    "cinewatch",
    "movies",
    "series",
    "anime",
    "streaming"
  ],
  "author": "Rand Bahjat",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.cinewatch.app",
    "productName": "CineWatch",
    "icon": "icon-512.png",
    "directories": {
      "output": "C:\\CinewatchBuild"
    },
    "artifactName": "CineWatch-v${version}-Setup.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CineWatch",
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [{
      "provider": "github",
      "owner": "RandBahjat",
      "repo": "CineWatch"
    }]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
