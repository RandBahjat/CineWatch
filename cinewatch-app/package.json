{
  "name": "cinewatch-app",
  "version": "1.0.0",
  "description": "CineWatch Movies & Series Standalone Mobile and Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "dev": "electron ."
  },
  "keywords": [
    "cinewatch",
    "movies",
    "series",
    "anime",
    "streaming"
  ],
  "author": "Rand Bahjat",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.cinewatch.app",
    "productName": "CineWatch",
    "icon": "icon-512.png",
    "directories": {
      "output": "C:\\CinewatchBuild"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "png-to-ico": "^3.0.2"
  }
}
